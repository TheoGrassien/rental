<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
    "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
    "https://checkstyle.org/dtds/configuration_1_3.dtd">

<!--
  Configuration minimale du TP 01.
  Chaque règle couvre un risque concret plutôt qu'une préférence de style.
-->
<module name="Checker">
    <property name="charset" value="UTF-8"/>
    <property name="severity" value="error"/>
    <property name="fileExtensions" value="java"/>

    <!-- Lignes trop longues : diffs et revues de code difficiles à lire. -->
    <module name="LineLength">
        <property name="max" value="120"/>
        <property name="ignorePattern" value="^(package|import) .*$"/>
    </module>

    <!-- Permet une exception locale justifiée avec @SuppressWarnings("checkstyle:<règle>"). -->
    <module name="SuppressWarningsFilter"/>

    <module name="TreeWalker">
        <module name="SuppressWarningsHolder"/>

        <!-- Imports inutilisés ou en double : bruit et dépendances fantômes. -->
        <module name="UnusedImports"/>
        <module name="RedundantImport"/>

        <!-- Accolades obligatoires : évite d'ajouter une ligne hors du bloc voulu. -->
        <module name="NeedBraces"/>

        <!-- Instruction vide (« ; » isolé) : souvent un bug, par exemple if (x); -->
        <module name="EmptyStatement"/>
    </module>
</module>
